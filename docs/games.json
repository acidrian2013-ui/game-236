    "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>Flappy Aviator</title><style>*{box-sizing:border-box;margin:0;padding:0;user-select:none;}body{background:#0c1524;color:#fff;font-family:system-ui,sans-serif;overflow:hidden;height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;}canvas{background:#132238;border:1px solid rgba(56,189,248,0.4);box-shadow:0 0 25px rgba(56,189,248,0.15);border-radius:6px;cursor:pointer;}#hud{position:absolute;top:16px;left:24px;right:24px;display:flex;justify-content:space-between;font-size:15px;font-weight:600;text-shadow:0 0 8px rgba(56,189,248,0.5);}.val{color:#38bdf8;}</style></head><body><div id=\"hud\"><div>SCORE: <span id=\"score\" class=\"val\">0</span></div><div>BEST: <span id=\"hi\" class=\"val\">0</span></div></div><canvas id=\"c\"></canvas><script>const canvas=document.getElementById('c'),ctx=canvas.getContext('2d'),scoreEl=document.getElementById('score'),hiEl=document.getElementById('hi');const W=650,H=520;canvas.width=W;canvas.height=H;let audio=null;function beep(f,d=0.08,t='sine'){try{if(!audio)audio=new(window.AudioContext||window.webkitAudioContext)();if(audio.state==='suspended')audio.resume();const o=audio.createOscillator(),g=audio.createGain();o.type=t;o.frequency.value=f;g.gain.setValueAtTime(0.08,audio.currentTime);g.gain.exponentialRampToValueAtTime(0.001,audio.currentTime+d);o.connect(g);g.connect(audio.destination);o.start();o.stop(audio.currentTime+d);}catch(e){}}let hi=parseInt(localStorage.getItem('unb_flappy_hi')||'0',10);hiEl.innerText=hi;let bird={x:100,y:H/2,vy:0,gravity:0.28,jump:-6,r:12},pipes=[],score=0,frames=0,over=false,started=false;function flap(){if(over){restart();return;}started=true;bird.vy=bird.jump;beep(550,0.08,'triangle');}window.addEventListener('keydown',e=>{if(e.code==='Space'||e.code==='ArrowUp')flap();});canvas.addEventListener('mousedown',flap);function restart(){bird.y=H/2;bird.vy=0;pipes=[];score=0;frames=0;scoreEl.innerText=0;over=false;started=false;}function update(){if(!started||over)return;frames++;bird.vy+=bird.gravity;bird.y+=bird.vy;if(bird.y-bird.r<0){bird.y=bird.r;bird.vy=0;}if(bird.y+bird.r>H-20){triggerDeath();return;}if(frames%100===0){const gap=125,topH=Math.floor(Math.random()*(H-gap-160))+60;pipes.push({x:W,top:topH,bottom:topH+gap,passed:false});}for(let i=pipes.length-1;i>=0;i--){const p=pipes[i];p.x-=2.8;if(bird.x+bird.r>p.x&&bird.x-bird.r<p.x+55){if(bird.y-bird.r<p.top||bird.y+bird.r>p.bottom){triggerDeath();return;}}if(!p.passed&&p.x+55<bird.x){p.passed=true;score++;scoreEl.innerText=score;if(score>hi){hi=score;hiEl.innerText=hi;localStorage.setItem('unb_flappy_hi',hi.toString());}beep(750,0.1,'sine');}if(p.x<-60)pipes.splice(i,1);}}function triggerDeath(){over=true;beep(180,0.35,'sawtooth');}function draw(){ctx.fillStyle='#132238';ctx.fillRect(0,0,W,H);ctx.fillStyle='rgba(255,255,255,0.06)';ctx.beginPath();ctx.arc(140,80,40,0,Math.PI*2);ctx.arc(180,80,50,0,Math.PI*2);ctx.arc(220,80,35,0,Math.PI*2);ctx.fill();for(let p of pipes){ctx.fillStyle='#10b981';ctx.fillRect(p.x,0,55,p.top);ctx.fillRect(p.x,p.bottom,55,H-p.bottom);ctx.fillStyle='#059669';ctx.fillRect(p.x-3,p.top-16,61,16);ctx.fillRect(p.x-3,p.bottom,61,16);}ctx.fillStyle='#0b1626';ctx.fillRect(0,H-20,W,20);ctx.fillStyle='#38bdf8';ctx.fillRect(0,H-20,W,2);ctx.save();ctx.translate(bird.x,bird.y);ctx.rotate(Math.min(Math.PI/4,Math.max(-Math.PI/4,bird.vy*0.08)));ctx.fillStyle='#fbbf24';ctx.beginPath();ctx.ellipse(0,0,15,11,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='#f59e0b';ctx.beginPath();ctx.ellipse(-3,2,7,5,0,0,Math.PI*2);ctx.fill();ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(7,-3,3,0,Math.PI*2);ctx.fill();ctx.fillStyle='#000';ctx.beginPath();ctx.arc(8,-3,1.5,0,Math.PI*2);ctx.fill();ctx.fillStyle='#ea580c';ctx.beginPath();ctx.moveTo(13,-1);ctx.lineTo(19,2);ctx.lineTo(13,5);ctx.closePath();ctx.fill();ctx.restore();if(!started&&!over){ctx.fillStyle='#fff';ctx.font='bold 22px system-ui';ctx.textAlign='center';ctx.fillText('PRESS SPACE OR CLICK TO TAKE OFF',W/2,H/2+40);}if(over){ctx.fillStyle='rgba(12,21,36,0.85)';ctx.fillRect(0,0,W,H);ctx.fillStyle='#f43f5e';ctx.font='bold 28px system-ui';ctx.textAlign='center';ctx.fillText('FLIGHT ABORTED',W/2,H/2-10);ctx.fillStyle='#94a3b8';ctx.font='15px system-ui';ctx.fillText('Press SPACEBAR or Click to Retry',W/2,H/2+25);}}function loop(){update();draw();requestAnimationFrame(loop);}loop();</script></body></html>"
