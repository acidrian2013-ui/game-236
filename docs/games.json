    "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>Cyber Snake</title><style>*{box-sizing:border-box;margin:0;padding:0;user-select:none;}body{background:#040810;color:#ecfdf5;font-family:system-ui,sans-serif;overflow:hidden;height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;}canvas{background:#06111e;border:1px solid rgba(16,185,129,0.4);box-shadow:0 0 25px rgba(16,185,129,0.15);border-radius:6px;}#bar{position:absolute;top:16px;left:24px;right:24px;display:flex;justify-content:space-between;font-size:14px;font-weight:600;text-shadow:0 0 8px rgba(16,185,129,0.6);}.neon{color:#10b981;}</style></head><body><div id=\"bar\"><div>SCORE: <span id=\"sc\" class=\"neon\">0</span> · SPEED: <span id=\"spd\" class=\"neon\">1x</span></div><div>BEST: <span id=\"hi\" class=\"neon\">0</span></div></div><canvas id=\"c\"></canvas><script>const canvas=document.getElementById('c'),ctx=canvas.getContext('2d'),scEl=document.getElementById('sc'),spdEl=document.getElementById('spd'),hiEl=document.getElementById('hi');const GRID=20,COLS=32,ROWS=22;canvas.width=COLS*GRID;canvas.height=ROWS*GRID;let audio=null;function beep(f,d,t='sine'){try{if(!audio)audio=new(window.AudioContext||window.webkitAudioContext)();if(audio.state==='suspended')audio.resume();const o=audio.createOscillator(),g=audio.createGain();o.type=t;o.frequency.value=f;g.gain.setValueAtTime(0.08,audio.currentTime);g.gain.exponentialRampToValueAtTime(0.001,audio.currentTime+d);o.connect(g);g.connect(audio.destination);o.start();o.stop(audio.currentTime+d);}catch(e){}}let hi=parseInt(localStorage.getItem('unb_snake_hi')||'0',10);hiEl.innerText=hi;let snake=[{x:10,y:10},{x:9,y:10},{x:8,y:10}],dir={x:1,y:0},nextDir={x:1,y:0},food={x:18,y:10,golden:false,timer:0},score=0,speed=90,lastTick=0,over=false,paused=false;function placeFood(){let isGolden=Math.random()<0.25,fx,fy,collision;do{fx=Math.floor(Math.random()*COLS);fy=Math.floor(Math.random()*ROWS);collision=snake.some(s=>s.x===fx&&s.y===fy);}while(collision);food={x:fx,y:fy,golden:isGolden,timer:isGolden?60:0};}window.addEventListener('keydown',e=>{if(['ArrowUp','KeyW'].includes(e.code)&&dir.y===0)nextDir={x:0,y:-1};if(['ArrowDown','KeyS'].includes(e.code)&&dir.y===0)nextDir={x:0,y:1};if(['ArrowLeft','KeyA'].includes(e.code)&&dir.x===0)nextDir={x:-1,y:0};if(['ArrowRight','KeyD'].includes(e.code)&&dir.x===0)nextDir={x:1,y:0};if(e.code==='Space')paused=!paused;if(over&&(e.code==='Space'||e.code==='KeyR'))restart();});function restart(){snake=[{x:10,y:10},{x:9,y:10},{x:8,y:10}];dir={x:1,y:0};nextDir={x:1,y:0};score=0;speed=90;scEl.innerText=0;spdEl.innerText='1x';over=false;placeFood();}placeFood();function step(){dir=nextDir;const head={x:snake[0].x+dir.x,y:snake[0].y+dir.y};if(head.x<0||head.x>=COLS||head.y<0||head.y>=ROWS){triggerOver();return;}if(snake.some(s=>s.x===head.x&&s.y===head.y)){triggerOver();return;}snake.unshift(head);if(head.x===food.x&&head.y===food.y){const pts=food.golden?50:10;score+=pts;scEl.innerText=score;if(score>hi){hi=score;hiEl.innerText=hi;localStorage.setItem('unb_snake_hi',hi.toString());}beep(food.golden?780:520,0.12,'square');if(speed>45){speed-=1.5;spdEl.innerText=((90/speed).toFixed(1))+'x';}placeFood();}else{snake.pop();}}function triggerOver(){over=true;beep(140,0.35,'sawtooth');}function draw(){ctx.fillStyle='#06111e';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.strokeStyle='rgba(16,185,129,0.05)';ctx.lineWidth=1;for(let x=0;x<canvas.width;x+=GRID){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,canvas.height);ctx.stroke();}for(let y=0;y<canvas.height;y+=GRID){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(canvas.width,y);ctx.stroke();}if(food.golden){ctx.fillStyle='#fbbf24';ctx.shadowColor='#fbbf24';ctx.shadowBlur=10;}else{ctx.fillStyle='#10b981';ctx.shadowColor='#10b981';ctx.shadowBlur=8;}ctx.beginPath();ctx.arc(food.x*GRID+GRID/2,food.y*GRID+GRID/2,GRID/2-2,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;snake.forEach((s,idx)=>{ctx.fillStyle=idx===0?'#34d399':(idx%2===0?'#059669':'#10b981');ctx.fillRect(s.x*GRID+1,s.y*GRID+1,GRID-2,GRID-2);});if(over){ctx.fillStyle='rgba(4,8,16,0.85)';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.fillStyle='#f87171';ctx.font='bold 28px system-ui';ctx.textAlign='center';ctx.fillText('CRASHED!',canvas.width/2,canvas.height/2-10);ctx.fillStyle='#94a3b8';ctx.font='15px system-ui';ctx.fillText('Press SPACE to Play Again',canvas.width/2,canvas.height/2+25);}}function loop(now){if(!over&&!paused&&now-lastTick>speed){step();lastTick=now;}draw();requestAnimationFrame(loop);}requestAnimationFrame(loop);</script></body></html>"
