    "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>Asteroids</title><style>*{box-sizing:border-box;margin:0;padding:0;user-select:none;}body{background:#050814;color:#f8fafc;font-family:system-ui,sans-serif;overflow:hidden;height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;}canvas{background:#070b1a;border:1px solid rgba(56,189,248,0.3);box-shadow:0 0 30px rgba(14,165,233,0.15);max-width:100%;max-height:100%;border-radius:6px;}#hud{position:absolute;top:16px;left:24px;right:24px;display:flex;justify-content:space-between;font-size:14px;font-weight:600;letter-spacing:0.05em;pointer-events:none;text-shadow:0 0 10px rgba(56,189,248,0.6);}.neon-text{color:#38bdf8;}</style></head><body><div id=\"hud\"><div>SCORE: <span id=\"score\" class=\"neon-text\">0</span> · LIVES: <span id=\"lives\" class=\"neon-text\">3</span></div><div>LEVEL: <span id=\"level\" class=\"neon-text\">1</span> · HIGH: <span id=\"highscore\" class=\"neon-text\">0</span></div></div><canvas id=\"c\"></canvas><script>const canvas=document.getElementById('c'),ctx=canvas.getContext('2d'),scoreEl=document.getElementById('score'),livesEl=document.getElementById('lives'),levelEl=document.getElementById('level'),highEl=document.getElementById('highscore');let W=800,H=550;canvas.width=W;canvas.height=H;let audioCtx=null;function playTone(freq,dur,type='sine'){try{if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)();if(audioCtx.state==='suspended')audioCtx.resume();const osc=audioCtx.createOscillator(),gain=audioCtx.createGain();osc.type=type;osc.frequency.setValueAtTime(freq,audioCtx.currentTime);gain.gain.setValueAtTime(0.08,audioCtx.currentTime);gain.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+dur);osc.connect(gain);gain.connect(audioCtx.destination);osc.start();osc.stop(audioCtx.currentTime+dur);}catch(e){}}let score=0,lives=3,level=1,highscore=parseInt(localStorage.getItem('unblocked_ast_hi')||'0',10);highEl.innerText=highscore;let ship={x:W/2,y:H/2,r:12,a:-Math.PI/2,rot:0,thrust:false,vx:0,vy:0,invuln:120};let keys={},lasers=[],asteroids=[],particles=[],gameOver=false,paused=false;function spawnAsteroids(count){asteroids=[];for(let i=0;i<count;i++){let x,y,dist;do{x=Math.random()*W;y=Math.random()*H;dist=Math.hypot(x-ship.x,y-ship.y);}while(dist<150);asteroids.push(createAsteroid(x,y,36));}}function createAsteroid(x,y,r){const vert=Math.floor(Math.random()*5)+8,offsets=[];for(let i=0;i<vert;i++)offsets.push((Math.random()*0.4+0.8));const speed=(40/r)*(0.8+Math.random()*0.7),angle=Math.random()*Math.PI*2;return{x,y,r,vert,offsets,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed,angle:0,rotSpeed:(Math.random()-0.5)*0.04};}function addExplosion(x,y,color,count=16){for(let i=0;i<count;i++){const ang=Math.random()*Math.PI*2,spd=Math.random()*3+1;particles.push({x,y,vx:Math.cos(ang)*spd,vy:Math.sin(ang)*spd,life:25+Math.random()*15,color});}}window.addEventListener('keydown',e=>{keys[e.code]=true;if(e.code==='KeyP')paused=!paused;if(gameOver&&(e.code==='Space'||e.code==='KeyR'))resetGame();if(e.code==='Space'&&!gameOver&&!paused){if(lasers.length<5){lasers.push({x:ship.x+Math.cos(ship.a)*ship.r,y:ship.y+Math.sin(ship.a)*ship.r,vx:Math.cos(ship.a)*8+ship.vx*0.5,vy:Math.sin(ship.a)*8+ship.vy*0.5,life:50});playTone(880,0.08,'sawtooth');}}});window.addEventListener('keyup',e=>{keys[e.code]=false;});function resetGame(){score=0;lives=3;level=1;gameOver=false;ship.x=W/2;ship.y=H/2;ship.vx=0;ship.vy=0;ship.a=-Math.PI/2;ship.invuln=120;scoreEl.innerText=score;livesEl.innerText=lives;levelEl.innerText=level;spawnAsteroids(4);}resetGame();function update(){if(paused)return;if(!gameOver){if(keys['ArrowLeft']||keys['KeyA'])ship.a-=0.07;if(keys['ArrowRight']||keys['KeyD'])ship.a+=0.07;ship.thrust=(keys['ArrowUp']||keys['KeyW']);if(ship.thrust){ship.vx+=Math.cos(ship.a)*0.12;ship.vy+=Math.sin(ship.a)*0.12;particles.push({x:ship.x-Math.cos(ship.a)*ship.r,y:ship.y-Math.sin(ship.a)*ship.r,vx:-Math.cos(ship.a)*2+(Math.random()-0.5),vy:-Math.sin(ship.a)*2+(Math.random()-0.5),life:12,color:'#38bdf8'});if(Math.random()<0.2)playTone(90,0.05,'triangle');}ship.vx*=0.985;ship.vy*=0.985;ship.x+=ship.vx;ship.y+=ship.vy;if(ship.x<0)ship.x=W;if(ship.x>W)ship.x=0;if(ship.y<0)ship.y=H;if(ship.y>H)ship.y=0;if(ship.invuln>0)ship.invuln--;}for(let i=lasers.length-1;i>=0;i--){const l=lasers[i];l.x+=l.vx;l.y+=l.vy;l.life--;if(l.x<0)l.x=W;if(l.x>W)l.x=0;if(l.y<0)l.y=H;if(l.y>H)l.y=0;let hit=false;for(let j=asteroids.length-1;j>=0;j--){const a=asteroids[j];if(Math.hypot(l.x-a.x,l.y-a.y)<a.r){hit=true;addExplosion(a.x,a.y,'#38bdf8',12);playTone(180,0.12,'square');score+=Math.floor(100/a.r*10);scoreEl.innerText=score;if(score>highscore){highscore=score;highEl.innerText=highscore;localStorage.setItem('unblocked_ast_hi',highscore.toString());}if(a.r>16){asteroids.push(createAsteroid(a.x,a.y,a.r/2));asteroids.push(createAsteroid(a.x,a.y,a.r/2));}asteroids.splice(j,1);break;}}if(hit||l.life<=0)lasers.splice(i,1);}for(let a of asteroids){a.x+=a.vx;a.y+=a.vy;a.angle+=a.rotSpeed;if(a.x<-a.r)a.x=W+a.r;if(a.x>W+a.r)a.x=-a.r;if(a.y<-a.r)a.y=H+a.r;if(a.y>H+a.r)a.y=-a.r;if(!gameOver&&ship.invuln<=0&&Math.hypot(ship.x-a.x,ship.y-a.y)<ship.r+a.r*0.75){addExplosion(ship.x,ship.y,'#f43f5e',24);playTone(90,0.4,'sawtooth');lives--;livesEl.innerText=lives;if(lives<=0){gameOver=true;}else{ship.x=W/2;ship.y=H/2;ship.vx=0;ship.vy=0;ship.invuln=120;}}}if(asteroids.length===0){level++;levelEl.innerText=level;spawnAsteroids(3+level);}for(let i=particles.length-1;i>=0;i--){const p=particles[i];p.x+=p.vx;p.y+=p.vy;p.life--;if(p.life<=0)particles.splice(i,1);}}function render(){ctx.fillStyle='#070b1a';ctx.fillRect(0,0,W,H);ctx.fillStyle='rgba(255,255,255,0.4)';for(let i=0;i<40;i++){const sx=(i*97)%W,sy=(i*131)%H;ctx.fillRect(sx,sy,(i%3===0?2:1),(i%3===0?2:1));}ctx.strokeStyle='#94a3b8';ctx.lineWidth=1.5;for(let a of asteroids){ctx.save();ctx.translate(a.x,a.y);ctx.rotate(a.angle);ctx.beginPath();for(let i=0;i<a.vert;i++){const ang=(i/a.vert)*Math.PI*2,rad=a.r*a.offsets[i];const px=Math.cos(ang)*rad,py=Math.sin(ang)*rad;if(i===0)ctx.moveTo(px,py);else ctx.lineTo(px,py);}ctx.closePath();ctx.stroke();ctx.restore();}ctx.fillStyle='#38bdf8';for(let l of lasers){ctx.beginPath();ctx.arc(l.x,l.y,2.5,0,Math.PI*2);ctx.fill();}for(let p of particles){ctx.fillStyle=p.color;ctx.globalAlpha=p.life/30;ctx.fillRect(p.x,p.y,2,2);}ctx.globalAlpha=1;if(!gameOver){if(ship.invuln%10<5){ctx.save();ctx.translate(ship.x,ship.y);ctx.rotate(ship.a);ctx.strokeStyle='#38bdf8';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(ship.r,0);ctx.lineTo(-ship.r,-ship.r*0.7);ctx.lineTo(-ship.r*0.5,0);ctx.lineTo(-ship.r,ship.r*0.7);ctx.closePath();ctx.stroke();if(ship.thrust){ctx.strokeStyle='#f59e0b';ctx.beginPath();ctx.moveTo(-ship.r*0.6,-ship.r*0.3);ctx.lineTo(-ship.r*1.4,0);ctx.lineTo(-ship.r*0.6,ship.r*0.3);ctx.stroke();}ctx.restore();}}else{ctx.fillStyle='#f8fafc';ctx.font='bold 32px system-ui';ctx.textAlign='center';ctx.fillText('MISSION FAILED',W/2,H/2-10);ctx.font='16px system-ui';ctx.fillStyle='#94a3b8';ctx.fillText('PRESS SPACEBAR TO RESTART',W/2,H/2+25);}if(paused){ctx.fillStyle='rgba(7,11,26,0.7)';ctx.fillRect(0,0,W,H);ctx.fillStyle='#38bdf8';ctx.font='bold 28px system-ui';ctx.textAlign='center';ctx.fillText('PAUSED',W/2,H/2);}}function loop(){update();render();requestAnimationFrame(loop);}loop();</script></body></html>"
