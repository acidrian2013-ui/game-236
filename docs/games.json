    "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>Brick Breaker</title><style>*{box-sizing:border-box;margin:0;padding:0;user-select:none;}body{background:#080711;color:#fff;font-family:system-ui,sans-serif;overflow:hidden;height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;}canvas{background:#0d0a1a;border:1px solid rgba(245,158,11,0.35);box-shadow:0 0 25px rgba(245,158,11,0.1);border-radius:6px;cursor:none;}#hdr{position:absolute;top:16px;left:24px;right:24px;display:flex;justify-content:space-between;font-size:14px;font-weight:600;text-shadow:0 0 8px rgba(245,158,11,0.5);}.val{color:#f59e0b;}</style></head><body><div id=\"hdr\"><div>SCORE: <span id=\"score\" class=\"val\">0</span> · LIVES: <span id=\"lives\" class=\"val\">3</span></div><div>STAGE: <span id=\"stage\" class=\"val\">1</span></div></div><canvas id=\"c\"></canvas><script>const canvas=document.getElementById('c'),ctx=canvas.getContext('2d'),scoreEl=document.getElementById('score'),livesEl=document.getElementById('lives'),stageEl=document.getElementById('stage');const W=750,H=520;canvas.width=W;canvas.height=H;let audio=null;function beep(f,d,t='sine'){try{if(!audio)audio=new(window.AudioContext||window.webkitAudioContext)();if(audio.state==='suspended')audio.resume();const o=audio.createOscillator(),g=audio.createGain();o.type=t;o.frequency.value=f;g.gain.setValueAtTime(0.08,audio.currentTime);g.gain.exponentialRampToValueAtTime(0.001,audio.currentTime+d);o.connect(g);g.connect(audio.destination);o.start();o.stop(audio.currentTime+d);}catch(e){}}let paddle={w:100,h:14,x:W/2-50,y:H-32,speed:7},ball={x:W/2,y:H-50,r:6,vx:4,vy:-5,stuck:true},score=0,lives=3,stage=1,bricks=[],over=false,won=false;const COLORS=['#ef4444','#f97316','#eab308','#22c55e','#06b6d4','#8b5cf6'];function buildBricks(){bricks=[];const rows=5,cols=9,bW=68,bH=20,pad=10,topOffset=60,leftOffset=25;for(let r=0;r<rows;r++){for(let c=0;c<cols;c++){bricks.push({x:leftOffset+c*(bW+pad),y:topOffset+r*(bH+pad),w:bW,h:bH,color:COLORS[r%COLORS.length],points:(rows-r)*15,alive:true});}}}buildBricks();window.addEventListener('mousemove',e=>{const rect=canvas.getBoundingClientRect(),mouseX=e.clientX-rect.left;paddle.x=Math.max(0,Math.min(W-paddle.w,mouseX-paddle.w/2));if(ball.stuck)ball.x=paddle.x+paddle.w/2;});window.addEventListener('keydown',e=>{if(e.code==='Space'){if(over||won)restart();else if(ball.stuck){ball.stuck=false;ball.vx=(Math.random()-0.5)*6;ball.vy=-5;beep(600,0.1);}}if(e.code==='ArrowLeft'){paddle.x=Math.max(0,paddle.x-25);if(ball.stuck)ball.x=paddle.x+paddle.w/2;}if(e.code==='ArrowRight'){paddle.x=Math.min(W-paddle.w,paddle.x+25);if(ball.stuck)ball.x=paddle.x+paddle.w/2;}});function restart(){score=0;lives=3;stage=1;scoreEl.innerText=score;livesEl.innerText=lives;stageEl.innerText=stage;over=false;won=false;paddle.x=W/2-paddle.w/2;ball.stuck=true;ball.x=paddle.x+paddle.w/2;ball.y=paddle.y-ball.r-2;buildBricks();}function update(){if(over||won)return;if(!ball.stuck){ball.x+=ball.vx;ball.y+=ball.vy;if(ball.x-ball.r<0){ball.x=ball.r;ball.vx=-ball.vx;beep(440,0.05);}if(ball.x+ball.r>W){ball.x=W-ball.r;ball.vx=-ball.vx;beep(440,0.05);}if(ball.y-ball.r<0){ball.y=ball.r;ball.vy=-ball.vy;beep(440,0.05);}if(ball.y-ball.r>H){lives--;livesEl.innerText=lives;beep(150,0.3,'sawtooth');if(lives<=0){over=true;}else{ball.stuck=true;ball.x=paddle.x+paddle.w/2;ball.y=paddle.y-ball.r-2;}}if(ball.y+ball.r>=paddle.y&&ball.y-ball.r<=paddle.y+paddle.h&&ball.x>=paddle.x&&ball.x<=paddle.x+paddle.w&&ball.vy>0){const hitPos=(ball.x-(paddle.x+paddle.w/2))/(paddle.w/2);ball.vx=hitPos*7;ball.vy=-Math.abs(ball.vy);beep(520,0.08);}let remaining=0;for(let b of bricks){if(b.alive){remaining++;if(ball.x+ball.r>b.x&&ball.x-ball.r<b.x+b.w&&ball.y+ball.r>b.y&&ball.y-ball.r<b.y+b.h){b.alive=false;ball.vy=-ball.vy;score+=b.points;scoreEl.innerText=score;beep(700+Math.random()*200,0.08,'triangle');break;}}}if(remaining===0){stage++;stageEl.innerText=stage;ball.stuck=true;ball.x=paddle.x+paddle.w/2;ball.y=paddle.y-ball.r-2;buildBricks();beep(880,0.2);}}}function draw(){ctx.fillStyle='#0d0a1a';ctx.fillRect(0,0,W,H);for(let b of bricks){if(b.alive){ctx.fillStyle=b.color;ctx.fillRect(b.x,b.y,b.w,b.h);ctx.fillStyle='rgba(255,255,255,0.2)';ctx.fillRect(b.x,b.y,b.w,4);}}ctx.fillStyle='#f59e0b';ctx.shadowColor='#f59e0b';ctx.shadowBlur=10;ctx.fillRect(paddle.x,paddle.y,paddle.w,paddle.h);ctx.shadowBlur=0;ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(ball.x,ball.y,ball.r,0,Math.PI*2);ctx.fill();if(over){ctx.fillStyle='rgba(13,10,26,0.85)';ctx.fillRect(0,0,W,H);ctx.fillStyle='#ef4444';ctx.font='bold 30px system-ui';ctx.textAlign='center';ctx.fillText('GAME OVER',W/2,H/2-10);ctx.fillStyle='#cbd5e1';ctx.font='15px system-ui';ctx.fillText('Press SPACEBAR to Restart',W/2,H/2+25);}}function loop(){update();draw();requestAnimationFrame(loop);}loop();</script></body></html>"
