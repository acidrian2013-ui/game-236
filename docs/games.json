  {
    "id": "minesweeper-retro",
    "title": "Retro Minesweeper",
    "category": "Puzzle",
    "description": "Uncover hidden minefields using deductive reasoning, numerical proximity clues, and quick flag placements.",
    "instructions": "Left-click to reveal cells. Right-click or hold to plant a danger flag. Click the smiley face to restart.",
    "controls": "Left Click to Dig · Right Click to Plant Flag · Click Smile to Reset",
    "type": "srcdoc",
    "aspectRatio": "16/9",
    "plays": 18400,
    "rating": 4.7,
    "colorTheme": "from-slate-500 to-zinc-600",
    "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>Minesweeper</title><style>*{box-sizing:border-box;margin:0;padding:0;user-select:none;}body{background:#0f172a;color:#f8fafc;font-family:system-ui,sans-serif;height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;}.case{background:#1e293b;border:2px solid #334155;padding:14px;border-radius:8px;box-shadow:0 10px 25px rgba(0,0,0,0.5);}.panel{background:#0f172a;border:1px solid #334155;padding:8px 12px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;border-radius:4px;}.counter{font-family:'Courier New',monospace;font-size:24px;font-weight:800;color:#ef4444;background:#020617;padding:2px 8px;border-radius:3px;letter-spacing:2px;}.face{font-size:22px;cursor:pointer;background:#334155;border:1px solid #475569;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;}.face:active{transform:scale(0.94);}.grid{display:grid;grid-template-columns:repeat(9,32px);grid-gap:2px;background:#0f172a;padding:4px;border:1px solid #334155;border-radius:4px;}.cell{width:32px;height:32px;background:#334155;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:700;cursor:pointer;border-radius:2px;}.cell:hover:not(.revealed){background:#475569;}.revealed{background:#1e293b;cursor:default;}.n1{color:#38bdf8;}.n2{color:#4ade80;}.n3{color:#f87171;}.n4{color:#c084fc;}.n5{color:#fbbf24;}.n6{color:#2dd4bf;}.mine{background:#ef4444!important;}</style></head><body><div class=\"case\"><div class=\"panel\"><div id=\"mines\" class=\"counter\">010</div><div id=\"face\" class=\"face\" onclick=\"init()\">🙂</div><div id=\"timer\" class=\"counter\">000</div></div><div id=\"grid\" class=\"grid\"></div></div><script>const ROWS=9,COLS=9,TOTAL_MINES=10;let board=[],revealedCount=0,flagsCount=0,timerVal=0,timerId=null,started=false,over=false;function init(){clearInterval(timerId);timerVal=0;started=false;over=false;revealedCount=0;flagsCount=0;document.getElementById('timer').innerText='000';document.getElementById('mines').innerText='010';document.getElementById('face').innerText='🙂';board=[];const gridEl=document.getElementById('grid');gridEl.innerHTML='';for(let r=0;r<ROWS;r++){board[r]=[];for(let c=0;c<COLS;c++){board[r][c]={mine:false,count:0,revealed:false,flagged:false};const cell=document.createElement('div');cell.className='cell';cell.dataset.r=r;cell.dataset.c=c;cell.onmousedown=(e)=>handleClick(e,r,c);cell.oncontextmenu=(e)=>e.preventDefault();gridEl.appendChild(cell);}}}function plantMines(startR,startC){let planted=0;while(planted<TOTAL_MINES){const r=Math.floor(Math.random()*ROWS),c=Math.floor(Math.random()*COLS);if(!board[r][c].mine&&!(r===startR&&c===startC)){board[r][c].mine=true;planted++;}}for(let r=0;r<ROWS;r++){for(let c=0;c<COLS;c++){if(!board[r][c].mine){let count=0;for(let dr=-1;dr<=1;dr++){for(let dc=-1;dc<=1;dc++){const nr=r+dr,nc=c+dc;if(nr>=0&&nr<ROWS&&nc>=0&&nc<COLS&&board[nr][nc].mine)count++;}}board[r][c].count=count;}}}}function handleClick(e,r,c){if(over)return;if(!started){started=true;plantMines(r,c);timerId=setInterval(()=>{timerVal=Math.min(999,timerVal+1);document.getElementById('timer').innerText=timerVal.toString().padStart(3,'0');},1000);}if(e.button===2){const cell=board[r][c];if(!cell.revealed){cell.flagged=!cell.flagged;flagsCount+=cell.flagged?1:-1;document.getElementById('mines').innerText=Math.max(0,TOTAL_MINES-flagsCount).toString().padStart(3,'0');renderCell(r,c);}return;}reveal(r,c);}function reveal(r,c){const cell=board[r][c];if(cell.revealed||cell.flagged||over)return;cell.revealed=true;revealedCount++;renderCell(r,c);if(cell.mine){over=true;clearInterval(timerId);document.getElementById('face').innerText='😵';for(let row=0;row<ROWS;row++){for(let col=0;col<COLS;col++){if(board[row][col].mine){board[row][col].revealed=true;renderCell(row,col);}}}return;}if(cell.count===0){for(let dr=-1;dr<=1;dr++){for(let dc=-1;dc<=1;dc++){const nr=r+dr,nc=c+dc;if(nr>=0&&nr<ROWS&&nc>=0&&nc<COLS)reveal(nr,nc);}}}if(revealedCount===ROWS*COLS-TOTAL_MINES){over=true;clearInterval(timerId);document.getElementById('face').innerText='😎';}}function renderCell(r,c){const el=document.querySelector('.cell[data-r=\"'+r+'\"][data-c=\"'+c+'\"]'),data=board[r][c];if(data.revealed){el.classList.add('revealed');if(data.mine){el.classList.add('mine');el.innerText='💣';}else if(data.count>0){el.innerText=data.count;el.classList.add('n'+data.count);}else{el.innerText='';}}else{el.innerText=data.flagged?'🚩':'';}}init();</script></body></html>"
