    "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>Cyber Pong</title><style>*{box-sizing:border-box;margin:0;padding:0;user-select:none;}body{background:#060511;color:#fff;font-family:system-ui,sans-serif;overflow:hidden;height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;}canvas{background:#0b091f;border:1px solid rgba(139,92,246,0.4);box-shadow:0 0 25px rgba(139,92,246,0.15);border-radius:6px;}#top{position:absolute;top:16px;left:24px;right:24px;display:flex;justify-content:space-between;align-items:center;}.score-txt{font-size:24px;font-weight:700;color:#a78bfa;letter-spacing:0.1em;}button{background:rgba(139,92,246,0.2);border:1px solid rgba(139,92,246,0.5);color:#c4b5fd;padding:6px 12px;border-radius:4px;font-size:12px;cursor:pointer;}button:hover{background:rgba(139,92,246,0.4);}</style></head><body><div id=\"top\"><div id=\"score\" class=\"score-txt\">0 : 0</div><button id=\"modeBtn\" onclick=\"toggleMode()\">MODE: 1P VS BOT</button></div><canvas id=\"c\"></canvas><script>const canvas=document.getElementById('c'),ctx=canvas.getContext('2d'),scoreEl=document.getElementById('score'),modeBtn=document.getElementById('modeBtn');const W=750,H=500;canvas.width=W;canvas.height=H;let isTwoPlayer=false;function toggleMode(){isTwoPlayer=!isTwoPlayer;modeBtn.innerText=isTwoPlayer?'MODE: 2P LOCAL (W/S vs ↑/↓)':'MODE: 1P VS BOT';resetGame();}let audio=null;function beep(f,d=0.08,t='square'){try{if(!audio)audio=new(window.AudioContext||window.webkitAudioContext)();if(audio.state==='suspended')audio.resume();const o=audio.createOscillator(),g=audio.createGain();o.type=t;o.frequency.value=f;g.gain.setValueAtTime(0.06,audio.currentTime);g.gain.exponentialRampToValueAtTime(0.001,audio.currentTime+d);o.connect(g);g.connect(audio.destination);o.start();o.stop(audio.currentTime+d);}catch(e){}}let p1={x:20,y:H/2-40,w:12,h:80,vy:0,score:0},p2={x:W-32,y:H/2-40,w:12,h:80,vy:0,score:0},ball={x:W/2,y:H/2,r:6,vx:5,vy:3},keys={},winner=null;window.addEventListener('keydown',e=>{keys[e.code]=true;if(winner&&e.code==='Space')resetGame();});window.addEventListener('keyup',e=>{keys[e.code]=false;});function resetBall(servingP2){ball.x=W/2;ball.y=H/2;ball.vx=(servingP2?-1:1)*5;ball.vy=(Math.random()-0.5)*6;}function resetGame(){p1.score=0;p2.score=0;winner=null;scoreEl.innerText='0 : 0';resetBall(false);}function update(){if(winner)return;if(keys['KeyW']||(!isTwoPlayer&&keys['ArrowUp']))p1.y=Math.max(0,p1.y-7);if(keys['KeyS']||(!isTwoPlayer&&keys['ArrowDown']))p1.y=Math.min(H-p1.h,p1.y+7);if(isTwoPlayer){if(keys['ArrowUp'])p2.y=Math.max(0,p2.y-7);if(keys['ArrowDown'])p2.y=Math.min(H-p2.h,p2.y+7);}else{const center=p2.y+p2.h/2;if(ball.vx>0){if(center<ball.y-12)p2.y+=5.5;else if(center>ball.y+12)p2.y-=5.5;}else{if(center<H/2-10)p2.y+=2;else if(center>H/2+10)p2.y-=2;}p2.y=Math.max(0,Math.min(H-p2.h,p2.y));}ball.x+=ball.vx;ball.y+=ball.vy;if(ball.y-ball.r<=0||ball.y+ball.r>=H){ball.vy=-ball.vy;beep(330,0.05);}if(ball.x-ball.r<=p1.x+p1.w&&ball.x+ball.r>=p1.x&&ball.y>=p1.y&&ball.y<=p1.y+p1.h&&ball.vx<0){const offset=(ball.y-(p1.y+p1.h/2))/(p1.h/2);ball.vx=Math.min(12,Math.abs(ball.vx)*1.05);ball.vy=offset*7;beep(440,0.06);}if(ball.x+ball.r>=p2.x&&ball.x-ball.r<=p2.x+p2.w&&ball.y>=p2.y&&ball.y<=p2.y+p2.h&&ball.vx>0){const offset=(ball.y-(p2.y+p2.h/2))/(p2.h/2);ball.vx=-Math.min(12,Math.abs(ball.vx)*1.05);ball.vy=offset*7;beep(520,0.06);}if(ball.x<0){p2.score++;scoreEl.innerText=p1.score+' : '+p2.score;beep(220,0.15);if(p2.score>=7)winner=isTwoPlayer?'PLAYER 2 WINS':'COMPUTER WINS';else resetBall(false);}else if(ball.x>W){p1.score++;scoreEl.innerText=p1.score+' : '+p2.score;beep(660,0.15);if(p1.score>=7)winner='PLAYER 1 WINS';else resetBall(true);}}function draw(){ctx.fillStyle='#0b091f';ctx.fillRect(0,0,W,H);ctx.strokeStyle='rgba(139,92,246,0.25)';ctx.setLineDash([8,8]);ctx.beginPath();ctx.moveTo(W/2,0);ctx.lineTo(W/2,H);ctx.stroke();ctx.setLineDash([]);ctx.fillStyle='#a78bfa';ctx.shadowColor='#8b5cf6';ctx.shadowBlur=8;ctx.fillRect(p1.x,p1.y,p1.w,p1.h);ctx.fillRect(p2.x,p2.y,p2.w,p2.h);ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(ball.x,ball.y,ball.r,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;if(winner){ctx.fillStyle='rgba(11,9,31,0.85)';ctx.fillRect(0,0,W,H);ctx.fillStyle='#a78bfa';ctx.font='bold 30px system-ui';ctx.textAlign='center';ctx.fillText(winner,W/2,H/2-10);ctx.fillStyle='#cbd5e1';ctx.font='15px system-ui';ctx.fillText('Press SPACE to Rematch',W/2,H/2+25);}}function loop(){update();draw();requestAnimationFrame(loop);}loop();</script></body></html>"
