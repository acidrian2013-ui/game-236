    "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>Connect Four</title><style>*{box-sizing:border-box;margin:0;padding:0;user-select:none;}body{background:#0c1222;color:#f8fafc;font-family:system-ui,sans-serif;height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;}.top-bar{display:flex;gap:20px;align-items:center;margin-bottom:12px;}.status{font-size:18px;font-weight:700;}button{background:#1e293b;color:#f8fafc;border:1px solid #334155;padding:6px 14px;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;}button:hover{background:#334155;}.board{background:#1e3a8a;padding:12px;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,0.6);display:grid;grid-template-columns:repeat(7,48px);grid-gap:8px;border:3px solid #172554;}.slot{width:48px;height:48px;background:#0c1222;border-radius:50%;cursor:pointer;transition:background 0.15s ease,transform 0.15s;}.slot:hover{transform:scale(1.05);}.p1{background:#ef4444!important;box-shadow:inset 0 -3px 5px rgba(0,0,0,0.3);}.p2{background:#facc15!important;box-shadow:inset 0 -3px 5px rgba(0,0,0,0.3);}</style></head><body><div class=\"top-bar\"><div id=\"status\" class=\"status\" style=\"color:#ef4444;\">RED'S TURN</div><button onclick=\"toggleBot()\" id=\"botBtn\">MODE: 1P VS BOT</button><button onclick=\"reset()\">RESTART</button></div><div id=\"board\" class=\"board\"></div><script>const ROWS=6,COLS=7;let grid=Array(ROWS).fill(null).map(()=>Array(COLS).fill(0)),turn=1,vsBot=true,over=false;function toggleBot(){vsBot=!vsBot;document.getElementById('botBtn').innerText=vsBot?'MODE: 1P VS BOT':'MODE: 2P LOCAL';reset();}function createBoard(){const b=document.getElementById('board');b.innerHTML='';for(let r=0;r<ROWS;r++){for(let c=0;c<COLS;c++){const slot=document.createElement('div');slot.className='slot';slot.dataset.c=c;slot.onclick=()=>dropToken(c);b.appendChild(slot);}}}function render(){const slots=document.querySelectorAll('.slot');slots.forEach((s,idx)=>{const r=Math.floor(idx/COLS),c=idx%COLS;s.className='slot '+(grid[r][c]===1?'p1':(grid[r][c]===2?'p2':''));});}function dropToken(col){if(over)return;for(let r=ROWS-1;r>=0;r--){if(grid[r][col]===0){grid[r][col]=turn;render();if(checkWin(r,col,turn)){over=true;document.getElementById('status').innerText=(turn===1?\"RED\":\"YELLOW\")+\" WINS!\";return;}turn=turn===1?2:1;updateStatus();if(vsBot&&turn===2&&!over){setTimeout(botMove,400);}return;}}}function updateStatus(){const el=document.getElementById('status');el.innerText=turn===1?\"RED'S TURN\":(vsBot?\"BOT THINKING...\":\"YELLOW'S TURN\");el.style.color=turn===1?\"#ef4444\":\"#facc15\";}function botMove(){if(over)return;let validCols=[];for(let c=0;c<COLS;c++)if(grid[0][c]===0)validCols.push(c);if(validCols.length===0)return;for(let c of validCols){for(let r=ROWS-1;r>=0;r--){if(grid[r][c]===0){grid[r][c]=2;if(checkWin(r,c,2)){render();over=true;document.getElementById('status').innerText=\"BOT WINS!\";return;}grid[r][c]=0;break;}}}for(let c of validCols){for(let r=ROWS-1;r>=0;r--){if(grid[r][c]===0){grid[r][c]=1;if(checkWin(r,c,1)){grid[r][c]=2;render();turn=1;updateStatus();return;}grid[r][c]=0;break;}}}const choice=validCols.includes(3)&&Math.random()<0.6?3:validCols[Math.floor(Math.random()*validCols.length)];dropToken(choice);}function checkWin(r,c,p){function count(dr,dc){let cnt=0,nr=r+dr,nc=c+dc;while(nr>=0&&nr<ROWS&&nc>=0&&nc<COLS&&grid[nr][nc]===p){cnt++;nr+=dr;nc+=dc;}return cnt;}return(count(0,1)+count(0,-1)>=3)||(count(1,0)+count(-1,0)>=3)||(count(1,1)+count(-1,-1)>=3)||(count(1,-1)+count(-1,1)>=3);}function reset(){grid=Array(ROWS).fill(null).map(()=>Array(COLS).fill(0));turn=1;over=false;updateStatus();render();}createBoard();reset();</script></body></html>"
  }
