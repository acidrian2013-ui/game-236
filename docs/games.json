    "content": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><title>Dino Runner</title><style>*{box-sizing:border-box;margin:0;padding:0;user-select:none;}body{background:#090e17;color:#f8fafc;font-family:system-ui,sans-serif;height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden;}canvas{background:#0f172a;border:1px solid rgba(16,185,129,0.3);border-radius:6px;box-shadow:0 0 25px rgba(0,0,0,0.4);cursor:pointer;}#hud{position:absolute;top:16px;left:24px;right:24px;display:flex;justify-content:space-between;font-family:monospace;font-size:16px;font-weight:700;color:#10b981;}</style></head><body><div id=\"hud\"><div>DIST: <span id=\"dist\">00000</span></div><div>HI: <span id=\"hi\">00000</span></div></div><canvas id=\"c\"></canvas><script>const canvas=document.getElementById('c'),ctx=canvas.getContext('2d'),distEl=document.getElementById('dist'),hiEl=document.getElementById('hi');const W=750,H=400;canvas.width=W;canvas.height=H;let audio=null;function beep(f,d=0.08,t='square'){try{if(!audio)audio=new(window.AudioContext||window.webkitAudioContext)();if(audio.state==='suspended')audio.resume();const o=audio.createOscillator(),g=audio.createGain();o.type=t;o.frequency.value=f;g.gain.setValueAtTime(0.06,audio.currentTime);g.gain.exponentialRampToValueAtTime(0.001,audio.currentTime+d);o.connect(g);g.connect(audio.destination);o.start();o.stop(audio.currentTime+d);}catch(e){}}let hi=parseInt(localStorage.getItem('unb_dino_hi')||'0',10);hiEl.innerText=hi.toString().padStart(5,'0');let dino={x:50,y:H-80,w:32,h:42,vy:0,jump:-12.5,gravity:0.65,duck:false},obstacles=[],speed=6,dist=0,over=false,frame=0;function jump(){if(over){restart();return;}if(dino.y>=H-80){dino.vy=dino.jump;beep(480,0.08);}}window.addEventListener('keydown',e=>{if(e.code==='Space'||e.code==='ArrowUp')jump();if(e.code==='ArrowDown')dino.duck=true;});window.addEventListener('keyup',e=>{if(e.code==='ArrowDown')dino.duck=false;});canvas.addEventListener('mousedown',jump);function restart(){dino.y=H-80;dino.vy=0;dino.duck=false;obstacles=[];speed=6;dist=0;over=false;}function update(){if(over)return;frame++;dist+=0.2;distEl.innerText=Math.floor(dist).toString().padStart(5,'0');if(Math.floor(dist)>hi){hi=Math.floor(dist);hiEl.innerText=hi.toString().padStart(5,'0');localStorage.setItem('unb_dino_hi',hi.toString());}speed=6+Math.min(8,dist*0.005);dino.vy+=dino.gravity;dino.y+=dino.vy;const ground=H-(dino.duck?65:80);if(dino.y>ground){dino.y=ground;dino.vy=0;}if(frame%Math.floor(Math.max(65,120-speed*4))===0){const isBird=dist>200&&Math.random()<0.3;obstacles.push({x:W,y:isBird?(Math.random()<0.5?H-110:H-75):H-75,w:isBird?30:(Math.random()<0.5?20:36),h:isBird?20:36,isBird});}for(let i=obstacles.length-1;i>=0;i--){const o=obstacles[i];o.x-=speed;const dW=dino.duck?44:28,dH=dino.duck?24:38;if(dino.x+dW>o.x&&dino.x<o.x+o.w&&dino.y+dH>o.y&&dino.y<o.y+o.h){over=true;beep(150,0.35,'sawtooth');}if(o.x<-50)obstacles.splice(i,1);}}function draw(){ctx.fillStyle='#0f172a';ctx.fillRect(0,0,W,H);ctx.strokeStyle='#334155';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(0,H-40);ctx.lineTo(W,H-40);ctx.stroke();ctx.fillStyle='#10b981';if(dino.duck){ctx.fillRect(dino.x,dino.y,44,25);ctx.fillStyle='#064e3b';ctx.fillRect(dino.x+36,dino.y+4,4,4);}else{ctx.fillRect(dino.x,dino.y,28,40);ctx.fillRect(dino.x+18,dino.y-10,18,14);ctx.fillStyle='#064e3b';ctx.fillRect(dino.x+28,dino.y-6,4,4);}for(let o of obstacles){if(o.isBird){ctx.fillStyle='#38bdf8';ctx.fillRect(o.x,o.y,o.w,o.h);}else{ctx.fillStyle='#f59e0b';ctx.fillRect(o.x,o.y,o.w,o.h);ctx.fillRect(o.x-4,o.y+8,o.w+8,6);}}if(over){ctx.fillStyle='rgba(15,23,42,0.85)';ctx.fillRect(0,0,W,H);ctx.fillStyle='#ef4444';ctx.font='bold 28px monospace';ctx.textAlign='center';ctx.fillText('GAME OVER',W/2,H/2-10);ctx.fillStyle='#cbd5e1';ctx.font='14px monospace';ctx.fillText('PRESS SPACE TO RESTART',W/2,H/2+25);}}function loop(){update();draw();requestAnimationFrame(loop);}loop();</script></body></html>"
